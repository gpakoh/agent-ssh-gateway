# Private SSE MCP transport — private env template
#
# Usage:
#   1. Copy this file to chatgpt.sse.env (gitignored — see .gitignore)
#   2. Fill in your values
#   3. Generate a private bearer token:
#        python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   4. Start: set -a && source chatgpt.sse.env && set +a && python3 scripts/mcp_sse_serve.py
#   5. Smoke: python3 scripts/mcp_sse_safe_smoke.py
#
# NEVER commit the real env file with actual tokens or URLs.
# NEVER use master key as MCP runtime credential.
# NEVER set MCP_HTTP_ALLOW_NON_LOOPBACK=true outside a reviewed private-network
# deployment — this is a private/local rehearsal entrypoint, not a public
# ChatGPT/OpenAI connector. No TLS, reverse proxy, or OAuth is wired for it.

# Gateway connection
GATEWAY_URL=<gateway-url>
GATEWAY_API_KEY=<agent-token>
GATEWAY_AGENT_TOKEN=<agent-token>

# MCP tool mode (mandatory safe mode for this entrypoint)
MCP_GATEWAY_TOOL_MODE=mcp_client
MCP_CLIENT_SAFE_MODE=true

# MCP access profile
MCP_ACCESS_PROFILE=mcp_client_safe

# Private SSE transport bind — loopback only, do not change without review
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8086

# Bearer token protecting /sse and /messages — generate your own, never reuse
# an existing gateway/agent token for this.
MCP_HTTP_BEARER_TOKEN=<generate-private-token>

# Optional comma-separated Origin allowlist (Phase 17B). Loopback origins
# (http(s)://127.0.0.1:*, http(s)://localhost:*, http(s)://[::1]:*) are
# already allowed by default, as is a request with no Origin header at
# all (CLI/curl/local MCP clients routinely omit it) — leave this unset
# unless you have a specific additional local origin to allow.
# NEVER add a public origin here — this does not make the entrypoint a
# public connector, it only widens the private allowlist, and any
# public/OpenAI connector remains a separate, explicitly-approved design.
# MCP_HTTP_ALLOWED_ORIGINS=<optional-comma-separated-loopback-origins>

# Project root (optional — for project_* tools)
# MCP_GATEWAY_PROJECT_ROOT=<project-root-path>
