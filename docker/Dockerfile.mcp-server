# agent-ssh-gateway MCP server — Streamable HTTP entrypoint image
FROM python:3.12-slim
LABEL description="agent-ssh-gateway MCP server (streamable-http, read/audit-first)"

ARG BUILD_SHA
ARG BUILD_TIME

ENV BUILD_SHA=${BUILD_SHA}
ENV BUILD_TIME=${BUILD_TIME}

# Security: Install only necessary packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    openssh-client \
    curl \
    xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# docker CLI (client only) so docker_* tools actually work. Static tarball
# from download.docker.com instead of Debian packages: Debian's docker.io
# pulls the full daemon stack; the static CLI tarball is one self-contained
# binary (~39MB). We extract only docker/docker -> /usr/bin/docker (matches
# DOCKER_BIN in examples/mcp_client_remote/fleet/docker_client.py) and drop
# the rest (dockerd/containerd/runc/ctr -- the daemon never runs inside this
# container; the tools talk to the host daemon via the mounted
# /var/run/docker.sock or DOCKER_HOST). Compose v2 is bundled with the CLI.
# NOTE: even with the CLI present, docker_* tools stay honestly unavailable
# in deployments without the socket mount or DOCKER_HOST -- that's decided
# at runtime by _unavailable_tool_reasons in examples/mcp_server/server.py.
RUN curl -fsSL --max-time 300 -o /tmp/docker.tgz \
    https://download.docker.com/linux/static/stable/x86_64/docker-27.5.1.tgz \
    && tar -xzf /tmp/docker.tgz -C /tmp docker/docker \
    && install -m 0755 /tmp/docker/docker /usr/bin/docker \
    && rm -rf /tmp/docker /tmp/docker.tgz

# nodejs/npm provide npx for the context7 docs tools (resolve_library_id,
# query_docs). Official Node tarball instead of Debian packages: apt's
# nodejs+npm pull a 250MB+ layer of build tooling; the tarball adds ~110MB
# (bin+lib only; include/ is C headers only needed for native addon
# compilation, which this image never does).
RUN curl -fsSL --max-time 300 -o /tmp/node.tar.xz \
    https://nodejs.org/dist/v20.19.2/node-v20.19.2-linux-x64.tar.xz \
    && tar -xJf /tmp/node.tar.xz -C /opt \
    && rm -rf /opt/node-v20.19.2-linux-x64/include \
      /opt/node-v20.19.2-linux-x64/share \
      /opt/node-v20.19.2-linux-x64/CHANGELOG.md \
      /opt/node-v20.19.2-linux-x64/LICENSE \
      /opt/node-v20.19.2-linux-x64/README.md \
    && rm -f /tmp/node.tar.xz
ENV PATH="/opt/node-v20.19.2-linux-x64/bin:$PATH"

# Security: Create non-root user
RUN groupadd -r -g 1000 appuser && \
    useradd -r -u 1000 -g appuser -d /app -s /sbin/nologin appuser

WORKDIR /app

# Security: Install Python dependencies from frozen lockfile
COPY pyproject.toml uv.lock ./
RUN python -m pip install --default-timeout=120 --no-cache-dir uv && \
    uv sync --frozen --no-dev --no-install-project && \
    rm -rf /root/.cache/pip /root/.cache/uv && \
    chmod -R 755 /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

# Copy application (MCP server imports app.*), MCP portal (server.py imports
# examples.mcp_client_remote.fleet.* too), and entrypoint scripts
COPY --chown=appuser:appuser app/ ./app/
COPY --chown=appuser:appuser examples/ ./examples/
COPY --chown=appuser:appuser scripts/ ./scripts/

# Security: Create necessary directories
RUN mkdir -p /app/data /tmp /var/lib/mcp-agent/sources && \
    chown -R appuser:appuser /app /tmp /var/lib/mcp-agent

RUN chmod -R 755 /app

# Switch to non-root user
USER appuser

# Read-only filesystem (except /tmp and /app/data)
VOLUME ["/tmp", "/app/data"]

# Health check: /healthz is exempted from bearer auth by BearerAuthMiddleware
# specifically for this — a real 200/failure signal instead of probing the
# bearer-protected /mcp endpoint, which always answered 401 without a token
# and spammed the container's logs with a misleading "unauthorized" line
# every 30s (curl -s without -f doesn't care about status either way).
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -sf --max-time 4 http://localhost:8087/healthz || exit 1

# Expose streamable-http port
EXPOSE 8087

# Security: Drop all capabilities
CMD ["python", "scripts/mcp_streamable_http_serve.py"]
