# agent-ssh-gateway MCP server — Streamable HTTP entrypoint image
# Toolchain binaries come from version-pinned OCI stages instead of ad-hoc
# runtime downloads. Registry layers are content-addressed/cacheable and avoid
# CI depending on three independent HTTPS artifact hosts during every rebuild.
FROM docker:27.5.1-cli@sha256:851f91d241214e7c6db86513b270d58776379aacc5eb9c4a87e5b47115e3065c AS docker-cli
FROM docker/compose-bin:v2.36.2 AS compose-bin
FROM node:20.19.2-slim@sha256:7cd3fbc830c75c92256fe1122002add9a1c025831af8770cd0bf8e45688ef661 AS node-runtime

FROM python:3.12-slim
LABEL description="agent-ssh-gateway MCP server (streamable-http, read/audit-first)"

ARG BUILD_SHA
ARG BUILD_TIME

# Security: Install only necessary packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    openssh-client \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# docker CLI (client only), Compose v2, and Node/npm/npx are copied from
# official OCI images. This keeps the runtime image daemon-free while making
# CI independent of download.docker.com, GitHub release assets, and nodejs.org.
# NOTE: docker_* tools still remain honestly unavailable at runtime when the
# host socket/DOCKER_HOST is absent; tool availability is decided separately.
COPY --from=docker-cli /usr/local/bin/docker /usr/bin/docker
COPY --from=compose-bin /docker-compose /usr/local/lib/docker/cli-plugins/docker-compose
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && docker --version \
    && docker compose version \
    && node --version \
    && npx --version

# Security: Create non-root user
RUN groupadd -r -g 1000 appuser && \
    useradd -r -u 1000 -g appuser -d /app -s /sbin/nologin appuser

WORKDIR /app

# Security: Install Python dependencies from frozen lockfile
COPY pyproject.toml uv.lock ./
RUN python -m pip install --default-timeout=120 --no-cache-dir uv && \
    uv sync --frozen --no-dev --no-install-project && \
    rm -rf /root/.cache/pip /root/.cache/uv && \
    chmod -R 755 /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

# Copy application (MCP server imports app.*), MCP portal (server.py imports
# examples.mcp_client_remote.fleet.* too), and entrypoint scripts
COPY --chown=appuser:appuser app/ ./app/
COPY --chown=appuser:appuser examples/ ./examples/
COPY --chown=appuser:appuser scripts/ ./scripts/

# Security: Create necessary directories
RUN mkdir -p /app/data /tmp /var/lib/mcp-agent/sources && \
    chown -R appuser:appuser /app /tmp /var/lib/mcp-agent

RUN chmod -R 755 /app

# Build metadata is intentionally applied only after all expensive/static
# dependency and application layers. BUILD_TIME changes on every CI run;
# placing these ENV instructions near the top would invalidate the cache for
# apt, Docker CLI, Compose, Node, Python dependencies, and application COPYs.
ENV BUILD_SHA=${BUILD_SHA}
ENV BUILD_TIME=${BUILD_TIME}

# Switch to non-root user
USER appuser

# Read-only filesystem (except /tmp and /app/data)
VOLUME ["/tmp", "/app/data"]

# Health check: /healthz is exempted from bearer auth by BearerAuthMiddleware
# specifically for this — a real 200/failure signal instead of probing the
# bearer-protected /mcp endpoint, which always answered 401 without a token
# and spammed the container's logs with a misleading "unauthorized" line
# every 30s (curl -s without -f doesn't care about status either way).
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -sf --max-time 4 http://localhost:8087/healthz || exit 1

# Expose streamable-http port
EXPOSE 8087

# Security: Drop all capabilities
CMD ["python", "scripts/mcp_streamable_http_serve.py"]
