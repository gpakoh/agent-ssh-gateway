# Docker Compose runtime environment — copy this file to .env and fill real values.
# Do not commit .env with real secrets.

API_KEY=change-me-generate-long-random-api-key
AGENT_TOKEN=change-me-generate-long-random-agent-token
AGENT_TOKEN_TTL=31536000
JWT_SECRET=change-me-generate-long-random-jwt-secret

# One-time token required to create the first admin account via the Web UI.
# Empty (unset) = first-admin registration is DISABLED (fail-closed).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SETUP_TOKEN=change-me-generate-long-random-setup-token

# PostgreSQL superuser password (mcp-postgres container)
POSTGRES_PASSWORD=change-me

# Fernet key for encrypting session credentials at rest.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-fernet-key

# Redis password (P1 trust boundary): Redis runs on a project-private internal
# network and refuses connections without this password. The gateway embeds it
# in its REDIS_URL as redis://:<password>@redis:6379/0, so it MUST be URL-safe
# -- token_hex qualifies (hex contains no reserved URL characters). The redis
# container itself requires REDIS_PASSWORD to be set; Compose will refuse to
# start without it.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
REDIS_PASSWORD=change-me-generate-long-url-safe-random-password

# Access control gate (Phase 12B)
ACCESS_CONTROL_ENABLED=true
ACCESS_CONTROL_ENFORCE_MASTER=false
ACCESS_CONTROL_PENDING_TTL=900
ACCESS_CONTROL_ALLOW_TTL=86400
ACCESS_CONTROL_DENY_TTL=86400
# ACCESS_CONTROL_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
